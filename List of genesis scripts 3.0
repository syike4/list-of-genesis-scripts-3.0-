-- Extract just the names for the reanimateNames list
local reanimateNames = {}
for _, scriptData in ipairs(reanimationScripts) do
    table.insert(reanimateNames, scriptData.name)
end

-- Function to execute reanimation script with config support (SILENT - NO NOTIFICATIONS)
local function ExecuteReanimation(scriptData)
    -- Play toggle sound only (no visual notification)
    
    -- Execute the script silently
    local success, errorMsg = pcall(function()
        -- Set config if available
        if scriptData.config then
            _G.ReanimationConfig = scriptData.config
        end
        
        -- Execute based on what's available (code takes priority)
        if scriptData.code then
            loadstring(scriptData.code)()
        elseif scriptData.url then
            -- For rawscripts.net URLs, we need to handle them differently
            if string.find(scriptData.url, "rawscripts.net") then
                -- Try to get the actual script from rawscripts
                local scriptContent = game:HttpGet(scriptData.url)
                loadstring(scriptContent)()
            else
                -- Regular GitHub or gist URLs
                loadstring(game:HttpGet(scriptData.url))()
            end
        end
    end)
    
    if not success then
        warn("Reanimation Error [" .. scriptData.name .. "]: " .. errorMsg)
    end
end

-- Create sidebar toggles (REANIMATE ADDED FIRST)
local ReanimateToggle, ReanimateLabel = CreateToggle("Reanimate", Sidebar)
ReanimateToggle.Position = UDim2.new(0, 5, 0, 10)

local RIGSToggle, RIGSLabel = CreateToggle("RIGS", Sidebar)
RIGSToggle.Position = UDim2.new(0, 5, 0, 65)

local ItemIDSToggle, ItemIDSLabel = CreateToggle("Item IDS", Sidebar)
ItemIDSToggle.Position = UDim2.new(0, 5, 0, 120)

local CreditsToggle, CreditsLabel = CreateToggle("Credits", Sidebar)
CreditsToggle.Position = UDim2.new(0, 5, 0, 175)

-- Reanimate toggle (main menu)
ReanimateToggle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        FadeOutAll(function()
            -- Set Reanimate as active toggle
            SetToggleActive(ReanimateToggle, ReanimateLabel)
            
            HideAllSidebarLines()
            ShowLineForToggle(ReanimateToggle)
            ClearScroller()
            
            -- Add all 38 reanimate toggles
            for i, scriptData in ipairs(reanimationScripts) do
                local toggle, label = CreateToggle(scriptData.name, Scroller)
                toggle.Position = UDim2.new(0, 10, 0, 10 + ((i-1) * 55))
                toggle.Size = UDim2.new(1, -20, 0, 45)
                
                -- Make these toggles clickable with white/black inversion
                toggle.InputBegan:Connect(function(clickInput)
                    if clickInput.UserInputType == Enum.UserInputType.MouseButton1 then
                        -- Play toggle sound
                        playToggleSound()
                        
                        -- Animate click
                        local originalBg = toggle.BackgroundColor3
                        local originalText = label.TextColor3
                        
                        local fadeToWhite = TweenService:Create(toggle, TweenInfo.new(0.3), {BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0})
                        fadeToWhite:Play()
                        
                        local textToBlack = TweenService:Create(label, TweenInfo.new(0.3), {TextColor3 = Color3.new(0, 0, 0)})
                        textToBlack:Play()
                        
                        -- Execute the reanimation script (silently)
                        ExecuteReanimation(scriptData)
                        
                        wait(0.3)
                        
                        local fadeBack = TweenService:Create(toggle, TweenInfo.new(0.3), {BackgroundColor3 = originalBg, BackgroundTransparency = 0.2})
                        fadeBack:Play()
                        
                        local textBack = TweenService:Create(label, TweenInfo.new(0.3), {TextColor3 = originalText})
                        textBack:Play()
                    end
                end)
            end
            
            -- Set scroller canvas size based on number of items
            Scroller.CanvasSize = UDim2.new(0, 0, 0, #reanimationScripts * 55 + 20)
            
            FadeInAll()
        end)
    end
end)

