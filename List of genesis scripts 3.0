-- Smooth drag functionality for toggle button
local toggleDragging = false
local toggleDragInput, toggleDragStart, toggleStartPos

local function toggleUpdate(input)
	local delta = input.Position - toggleDragStart
	local newX = toggleStartPos.X.Offset + delta.X
	local newY = toggleStartPos.Y.Offset + delta.Y
	
	-- Apply easing for smooth movement
	local tween = TweenService:Create(ToggleButton, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.new(toggleStartPos.X.Scale, newX, toggleStartPos.Y.Scale, newY)
	})
	tween:Play()
end

ToggleButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		toggleDragging = true
		toggleDragStart = input.Position
		toggleStartPos = ToggleButton.Position
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				toggleDragging = false
			end
		end)
	end
end)

ToggleButton.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		toggleDragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if toggleDragging and (input == toggleDragInput) then
		toggleUpdate(input)
	end
end)

ToggleButton.MouseButton1Click:Connect(function()
	if not toggleDragging then
		local isVisible = MainFrame.Visible
		
		if isVisible then
			FadeOutAll(function()
				MainFrame.Visible = false
			end)
			
			-- Fade out toggle button outline when closing
			local outlineOut = TweenService:Create(ToggleStroke, TweenInfo.new(0.3), {Transparency = 1})
			outlineOut:Play()
		else
			MainFrame.Visible = true
			-- Set Reanimate as active by default when opening
			SetToggleActive(ReanimateToggle, ReanimateLabel)
			HideAllSidebarLines()
			ShowLineForToggle(ReanimateToggle)
			ClearScroller()
			
			-- Add all 38 reanimate toggles
			for i, scriptData in ipairs(reanimationScripts) do
				local toggle, label = CreateToggle(scriptData.name, Scroller)
				toggle.Position = UDim2.new(0, 10, 0, 10 + ((i-1) * 55))
				toggle.Size = UDim2.new(1, -20, 0, 45)
				
				-- Make these toggles clickable with white/black inversion
				toggle.InputBegan:Connect(function(clickInput)
					if clickInput.UserInputType == Enum.UserInputType.MouseButton1 then
						-- Play toggle sound
						playToggleSound()
						
						-- Animate click
						local originalBg = toggle.BackgroundColor3
						local originalText = label.TextColor3
						
						local fadeToWhite = TweenService:Create(toggle, TweenInfo.new(0.3), {BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0})
						fadeToWhite:Play()
						
						local textToBlack = TweenService:Create(label, TweenInfo.new(0.3), {TextColor3 = Color3.new(0, 0, 0)})
						textToBlack:Play()
						
						-- Execute the reanimation script (silently)
						ExecuteReanimation(scriptData)
						
						wait(0.3)
						
						local fadeBack = TweenService:Create(toggle, TweenInfo.new(0.3), {BackgroundColor3 = originalBg, BackgroundTransparency = 0.2})
						fadeBack:Play()
						
						local textBack = TweenService:Create(label, TweenInfo.new(0.3), {TextColor3 = originalText})
						textBack:Play()
					end
				end)
			end
			
			-- Set scroller canvas size based on number of items
			Scroller.CanvasSize = UDim2.new(0, 0, 0, #reanimationScripts * 55 + 20)
			
			FadeInAll()
			
			-- Fade in toggle button outline when opening
			local outlineIn = TweenService:Create(ToggleStroke, TweenInfo.new(0.3), {Transparency = 0.5})
			outlineIn:Play()
		end
	end
end)

-- Parent everything
ScreenGui.Parent = player:WaitForChild("PlayerGui")
MainFrame.Parent = ScreenGui
ToggleButton.Parent = ScreenGui

-- Update avatar when player changes
player.CharacterAdded:Connect(function()
	AvatarImage.Image = "rbxthumb://type=AvatarHeadShot&id=" .. player.UserId .. "&w=150&h=150"
end)

-- Handle screen size changes for mobile
if isMobile then
	game:GetService("GuiService"):GetSafeAreaInsetsChangedSignal():Connect(function()
		local safeArea = game:GetService("GuiService"):GetSafeAreaInsets()
		MainFrame.Size = UDim2.new(0.85, 0, 0.7, 0)
		MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
		MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	end)
end

print("Reanimate GUI loaded successfully with all 38 scripts!")
