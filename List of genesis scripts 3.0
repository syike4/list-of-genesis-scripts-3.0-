-- Variables
local activeSidebarToggle = nil
local activeSidebarTextLabel = nil

-- Toggle button template
local function CreateToggle(name, parent)
	local Toggle = Instance.new("Frame")
	Toggle.Name = name .. "Toggle"
	Toggle.Size = UDim2.new(1, -10, 0, 45)
	Toggle.BackgroundColor3 = Color3.new(0.08, 0.08, 0.08)
	Toggle.BackgroundTransparency = 0.2
	Toggle.BorderSizePixel = 0
	
	local ToggleCorner = Instance.new("UICorner")
	ToggleCorner.CornerRadius = UDim.new(0, 10)
	ToggleCorner.Parent = Toggle
	
	local ToggleLabel = Instance.new("TextLabel")
	ToggleLabel.Name = "ToggleLabel"
	ToggleLabel.Size = UDim2.new(1, -20, 1, 0)
	ToggleLabel.Position = UDim2.new(0, 10, 0, 0)
	ToggleLabel.Text = name
	ToggleLabel.Font = Enum.Font.GothamSemibold
	ToggleLabel.TextSize = 16
	ToggleLabel.TextColor3 = Color3.new(1, 1, 1)
	ToggleLabel.BackgroundTransparency = 1
	ToggleLabel.TextXAlignment = Enum.TextXAlignment.Left
	ToggleLabel.Parent = Toggle
	
	local ToggleStroke = Instance.new("UIStroke")
	ToggleStroke.Color = Color3.new(1, 1, 1)
	ToggleStroke.Thickness = 1
	ToggleStroke.Transparency = 1
	ToggleStroke.Parent = Toggle
	
	local HorizontalLine = Instance.new("Frame")
	HorizontalLine.Name = "HorizontalLine"
	HorizontalLine.Size = UDim2.new(1, 0, 0, 2)
	HorizontalLine.Position = UDim2.new(0, 0, 1, 0)
	HorizontalLine.BackgroundColor3 = Color3.new(1, 1, 1)
	HorizontalLine.BackgroundTransparency = 1
	HorizontalLine.BorderSizePixel = 0
	HorizontalLine.Parent = Toggle
	
	local LineGradient = Instance.new("UIGradient")
	LineGradient.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
		ColorSequenceKeypoint.new(0.5, Color3.new(1, 1, 1)),
		ColorSequenceKeypoint.new(1, Color3.new(1, 1, 1))
	}
	LineGradient.Transparency = NumberSequence.new{
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.15, 0.2),
		NumberSequenceKeypoint.new(0.85, 0.2),
		NumberSequenceKeypoint.new(1, 1)
	}
	LineGradient.Parent = HorizontalLine
	
	local LineCorner = Instance.new("UICorner")
	LineCorner.CornerRadius = UDim.new(0, 1)
	LineCorner.Parent = HorizontalLine
	
	Toggle.MouseEnter:Connect(function()
		if Toggle ~= activeSidebarToggle then
			TweenService:Create(ToggleStroke, TweenInfo.new(0.2), {Transparency = 0.5}):Play()
		end
	end)
	
	Toggle.MouseLeave:Connect(function()
		if Toggle ~= activeSidebarToggle then
			TweenService:Create(ToggleStroke, TweenInfo.new(0.2), {Transparency = 1}):Play()
		end
	end)
	
	Toggle.Parent = parent
	return Toggle, ToggleLabel
end

-- Set toggle active
local function SetToggleActive(toggleFrame, textLabel)
	if activeSidebarToggle then
		TweenService:Create(activeSidebarToggle, TweenInfo.new(0.3), {
			BackgroundColor3 = Color3.new(0.08, 0.08, 0.08),
			BackgroundTransparency = 0.2
		}):Play()
		
		if activeSidebarTextLabel then
			TweenService:Create(activeSidebarTextLabel, TweenInfo.new(0.3), {
				TextColor3 = Color3.new(1, 1, 1)
			}):Play()
		end
		
		local oldStroke = activeSidebarToggle:FindFirstChild("UIStroke")
		if oldStroke then
			TweenService:Create(oldStroke, TweenInfo.new(0.3), {Transparency = 1}):Play()
		end
	end
	
	playToggleSound()
	
	TweenService:Create(toggleFrame, TweenInfo.new(0.3), {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0
	}):Play()
	
	TweenService:Create(textLabel, TweenInfo.new(0.3), {
		TextColor3 = Color3.new(0, 0, 0)
	}):Play()
	
	local newStroke = toggleFrame:FindFirstChild("UIStroke")
	if newStroke then
		TweenService:Create(newStroke, TweenInfo.new(0.3), {Transparency = 0.5}):Play()
	end
	
	activeSidebarToggle = toggleFrame
	activeSidebarTextLabel = textLabel
end

-- Credit button template
local function CreateCreditButton(name, decalId, youtubeLink, parent, yPos)
	local CreditButton = Instance.new("TextButton")
	CreditButton.Name = name .. "CreditButton"
	CreditButton.Size = UDim2.new(1, -20, 0, 80)
	CreditButton.Position = UDim2.new(0, 10, 0, yPos)
	CreditButton.Text = ""
	CreditButton.BackgroundColor3 = Color3.new(0.08, 0.08, 0.08)
	CreditButton.BackgroundTransparency = 0.2
	CreditButton.BorderSizePixel = 0

	local CreditCorner = Instance.new("UICorner")
	CreditCorner.CornerRadius = UDim.new(0, 10)
	CreditCorner.Parent = CreditButton

	local CreditStroke = Instance.new("UIStroke")
	CreditStroke.Color = Color3.new(1, 1, 1)
	CreditStroke.Transparency = 1
	CreditStroke.Thickness = 1
	CreditStroke.Parent = CreditButton

	CreditButton.MouseEnter:Connect(function()
		TweenService:Create(CreditStroke, TweenInfo.new(0.2), {Transparency = 0.5}):Play()
	end)
	
	CreditButton.MouseLeave:Connect(function()
		TweenService:Create(CreditStroke, TweenInfo.new(0.2), {Transparency = 1}):Play()
	end)

	local NameLabel = Instance.new("TextLabel")
	NameLabel.Name = "NameLabel"
	NameLabel.Size = UDim2.new(1, -80, 1, 0)
	NameLabel.Position = UDim2.new(0, 10, 0, 0)
	NameLabel.Text = name
	NameLabel.Font = Enum.Font.GothamBold
	NameLabel.TextSize = 16
	NameLabel.TextColor3 = Color3.new(1, 1, 1)
	NameLabel.BackgroundTransparency = 1
	NameLabel.TextXAlignment = Enum.TextXAlignment.Left
	NameLabel.TextYAlignment = Enum.TextYAlignment.Center
	NameLabel.Parent = CreditButton

	local DecalImage = Instance.new("ImageLabel")
	DecalImage.Name = "DecalImage"
	DecalImage.Size = UDim2.new(0, 60, 0, 60)
	DecalImage.Position = UDim2.new(1, -70, 0.5, -30)
	DecalImage.BackgroundTransparency = 1
	DecalImage.Image = "rbxassetid://" .. decalId
	DecalImage.Parent = CreditButton

	local DecalCorner = Instance.new("UICorner")
	DecalCorner.CornerRadius = UDim.new(0, 8)
	DecalCorner.Parent = DecalImage

	CreditButton.MouseButton1Click:Connect(function()
		local originalBg = CreditButton.BackgroundColor3
		local originalTextColor = NameLabel.TextColor3
		
		playToggleSound()
		
		TweenService:Create(CreditButton, TweenInfo.new(0.3), {BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0}):Play()
		TweenService:Create(NameLabel, TweenInfo.new(0.3), {TextColor3 = Color3.new(0, 0, 0)}):Play()
		TweenService:Create(DecalImage, TweenInfo.new(0.3), {ImageColor3 = Color3.new(0, 0, 0)}):Play()
		
		wait(0.3)
		
		TweenService:Create(CreditButton, TweenInfo.new(0.3), {BackgroundColor3 = originalBg, BackgroundTransparency = 0.2}):Play()
		TweenService:Create(NameLabel, TweenInfo.new(0.3), {TextColor3 = originalTextColor}):Play()
		TweenService:Create(DecalImage, TweenInfo.new(0.3), {ImageColor3 = Color3.new(1, 1, 1)}):Play()
	end)

	CreditButton.Parent = parent
	return CreditButton
end

-- Item ID button template
local function CreateItemButton(name, parent, yPos, itemId)
	local ItemContainer = Instance.new("Frame")
	ItemContainer.Name = name .. "Container"
	ItemContainer.Size = UDim2.new(1, -20, 0, 45)
	ItemContainer.Position = UDim2.new(0, 10, 0, yPos)
	ItemContainer.BackgroundTransparency = 1
	ItemContainer.BorderSizePixel = 0
	ItemContainer.Parent = parent

	local ItemButton = Instance.new("TextButton")
	ItemButton.Name = name .. "Button"
	ItemButton.Size = UDim2.new(1, -55, 1, 0)
	ItemButton.Position = UDim2.new(0, 0, 0, 0)
	ItemButton.Text = name
	ItemButton.Font = Enum.Font.GothamSemibold
	ItemButton.TextSize = 16
	ItemButton.TextColor3 = Color3.new(1, 1, 1)
	ItemButton.BackgroundColor3 = Color3.new(0.08, 0.08, 0.08)
	ItemButton.BackgroundTransparency = 0.2
	ItemButton.BorderSizePixel = 0
	ItemButton.Parent = ItemContainer

	local ItemCorner = Instance.new("UICorner")
	ItemCorner.CornerRadius = UDim.new(0, 10)
	ItemCorner.Parent = ItemButton

	local ItemStroke = Instance.new("UIStroke")
	ItemStroke.Name = "ItemStroke"
	ItemStroke.Color = Color3.new(1, 1, 1)
	ItemStroke.Transparency = 1
	ItemStroke.Thickness = 1
	ItemStroke.Parent = ItemButton

	local GraySquare = Instance.new("Frame")
	GraySquare.Name = "GraySquare"
	GraySquare.Size = UDim2.new(0, 45, 1, 0)
	GraySquare.Position = UDim2.new(1, -45, 0, 0)
	GraySquare.BackgroundColor3 = Color3.new(0.3, 0.3, 0.3)
	GraySquare.BackgroundTransparency = 0.2
	GraySquare.BorderSizePixel = 0
	GraySquare.Parent = ItemContainer

	local SquareCorner = Instance.new("UICorner")
	SquareCorner.CornerRadius = UDim.new(0, 10)
	SquareCorner.Parent = GraySquare

	local SquareStroke = Instance.new("UIStroke")
	SquareStroke.Name = "SquareStroke"
	SquareStroke.Color = Color3.new(1, 1, 1)
	SquareStroke.Transparency = 1
	SquareStroke.Thickness = 1
	SquareStroke.Parent = GraySquare

	if itemId then
		local ItemImage = Instance.new("ImageLabel")
		ItemImage.Name = "ItemImage"
		ItemImage.Size = UDim2.new(0.8, 0, 0.8, 0)
		ItemImage.Position = UDim2.new(0.1, 0, 0.1, 0)
		ItemImage.BackgroundColor3 = Color3.new(0.2, 0.2, 0.2)
		ItemImage.BackgroundTransparency = 0.5
		ItemImage.BorderSizePixel = 0
		ItemImage.Image = "rbxthumb://type=Asset&id=" .. itemId .. "&w=150&h=150"
		ItemImage.Parent = GraySquare
		
		local ImageCorner = Instance.new("UICorner")
		ImageCorner.CornerRadius = UDim.new(0, 6)
		ImageCorner.Parent = ItemImage
		
		GraySquare.MouseEnter:Connect(function()
			TweenService:Create(ItemImage, TweenInfo.new(0.2), {
				Size = UDim2.new(0.9, 0, 0.9, 0),
				Position = UDim2.new(0.05, 0, 0.05, 0),
				BackgroundTransparency = 0.2
			}):Play()
		end)
		
		GraySquare.MouseLeave:Connect(function()
			TweenService:Create(ItemImage, TweenInfo.new(0.2), {
				Size = UDim2.new(0.8, 0, 0.8, 0),
				Position = UDim2.new(0.1, 0, 0.1, 0),
				BackgroundTransparency = 0.5
			}):Play()
		end)
	end

	if itemId then
		spawn(function()
			local function checkIfEquipped()
				local character = player.Character
				if character then
					for _, accessory in pairs(character:GetChildren()) do
						if accessory:IsA("Accessory") then
							local handle = accessory:FindFirstChild("Handle")
							if handle then
								local mesh = handle:FindFirstChildOfClass("SpecialMesh")
								if mesh and mesh.TextureId then
									local textureId = mesh.TextureId:match("%d+")
									if textureId == itemId then
										ItemStroke.Color = Color3.new(0, 1, 0)
										ItemStroke.Transparency = 0.3
										return true
									end
								end
							end
						end
					end
				end
				ItemStroke.Color = Color3.new(1, 1, 1)
				ItemStroke.Transparency = 1
				return false
			end
			
			checkIfEquipped()
			
			player.CharacterAdded:Connect(function(char)
				wait(1)
				checkIfEquipped()
			end)
			
			if player.Character then
				player.Character.ChildAdded:Connect(function()
					wait(0.1)
					checkIfEquipped()
				end)
				player.Character.ChildRemoved:Connect(function()
					wait(0.1)
					checkIfEquipped()
				end)
			end
		end)
	end

	ItemButton.MouseEnter:Connect(function()
		if ItemStroke.Color == Color3.new(1, 1, 1) then
			TweenService:Create(ItemStroke, TweenInfo.new(0.2), {Transparency = 0.3}):Play()
		end
	end)
	
	ItemButton.MouseLeave:Connect(function()
		if ItemStroke.Color == Color3.new(1, 1, 1) then
			TweenService:Create(ItemStroke, TweenInfo.new(0.2), {Transparency = 1}):Play()
		end
	end)

	GraySquare.MouseEnter:Connect(function()
		TweenService:Create(SquareStroke, TweenInfo.new(0.2), {Transparency = 0.3}):Play()
	end)
	
	GraySquare.MouseLeave:Connect(function()
		TweenService:Create(SquareStroke, TweenInfo.new(0.2), {Transparency = 1}):Play()
	end)

	ItemButton.MouseButton1Click:Connect(function()
		local originalBg = ItemButton.BackgroundColor3
		local originalTextColor = ItemButton.TextColor3
		
		playToggleSound()
		
		TweenService:Create(ItemButton, TweenInfo.new(0.3), {BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0}):Play()
		TweenService:Create(ItemButton, TweenInfo.new(0.3), {TextColor3 = Color3.new(0, 0, 0)}):Play()
		
		local originalText = ItemButton.Text
		ItemButton.Text = "Copied!"
		copyToClipboard(itemId or "")
		
		wait(0.3)
		
		TweenService:Create(ItemButton, TweenInfo.new(0.3), {BackgroundColor3 = originalBg, BackgroundTransparency = 0.2}):Play()
		TweenService:Create(ItemButton, TweenInfo.new(0.3), {TextColor3 = originalTextColor}):Play()
		
		wait(0.3)
		ItemButton.Text = originalText
	end)

	return ItemContainer
end

-- Clear scroller
local function ClearScroller()
	for _, child in pairs(Scroller:GetChildren()) do
		if child:IsA("GuiObject") then child:Destroy() end
	end
end

-- Hide all sidebar lines
local function HideAllSidebarLines()
	for _, toggle in pairs(Sidebar:GetChildren()) do
		if toggle:IsA("Frame") then
			local line = toggle:FindFirstChild("HorizontalLine")
			if line then
				TweenService:Create(line, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
			end
		end
	end
end

-- Show line for toggle
local function ShowLineForToggle(toggleFrame)
	local line = toggleFrame:FindFirstChild("HorizontalLine")
	if line then
		TweenService:Create(line, TweenInfo.new(0.3), {BackgroundTransparency = 0}):Play()
	end
end

-- Fade functions
local function FadeOutAll(callback)
	local tweens = {}
	table.insert(tweens, TweenService:Create(MainFrame, TweenInfo.new(0.3), {BackgroundTransparency = 1}))
	table.insert(tweens, TweenService:Create(UIStroke, TweenInfo.new(0.3), {Transparency = 1}))
	
	for _, child in pairs(MainFrame:GetDescendants()) do
		if child:IsA("TextLabel") or child:IsA("TextButton") then
			table.insert(tweens, TweenService:Create(child, TweenInfo.new(0.3), {TextTransparency = 1}))
		end
		if child:IsA("Frame") or child:IsA("ScrollingFrame") then
			if child.BackgroundTransparency < 1 then
				table.insert(tweens, TweenService:Create(child, TweenInfo.new(0.3), {BackgroundTransparency = 1}))
			end
		end
		if child:IsA("UIStroke") then
			table.insert(tweens, TweenService:Create(child, TweenInfo.new(0.3), {Transparency = 1}))
		end
		if child:IsA("ImageLabel") then
			table.insert(tweens, TweenService:Create(child, TweenInfo.new(0.3), {ImageTransparency = 1}))
		end
	end
	
	for _, tween in pairs(tweens) do tween:Play() end
	wait(0.3)
	if callback then callback() end
end

local function FadeInAll()
	local tweens = {}
	table.insert(tweens, TweenService:Create(MainFrame, TweenInfo.new(0.3), {BackgroundTransparency = 0.3}))
	table.insert(tweens, TweenService:Create(UIStroke, TweenInfo.new(0.3), {Transparency = 0.7}))
	
	for _, child in pairs(MainFrame:GetDescendants()) do
		if child:IsA("TextLabel") or child:IsA("TextButton") then
			local targetTransparency = 0
			if child.Name == "UserName" then targetTransparency = 0.4
			elseif child.Name == "SubtitleLabel" then targetTransparency = 0.6 end
			table.insert(tweens, TweenService:Create(child, TweenInfo.new(0.3), {TextTransparency = targetTransparency}))
		end
		if child:IsA("Frame") or child:IsA("ScrollingFrame") then
			if child.Name ~= "MainFrame" then
				if child.Name:match("Toggle") or child.Name:match("Button") or child.Name == "GraySquare" then
					if child ~= activeSidebarToggle then
						table.insert(tweens, TweenService:Create(child, TweenInfo.new(0.3), {BackgroundTransparency = 0.2}))
					end
				elseif child.Name ~= "SidebarContainer" and child.Name ~= "ContentContainer" then
					table.insert(tweens, TweenService:Create(child, TweenInfo.new(0.3), {BackgroundTransparency = 1}))
				end
			end
		end
		if child:IsA("UIStroke") and child.Parent.Name ~= "MainFrame" then
			if child.Parent ~= activeSidebarToggle and not (child.Parent.Name:match("Button") or child.Parent.Name == "GraySquare") then
				table.insert(tweens, TweenService:Create(child, TweenInfo.new(0.3), {Transparency = 1}))
			elseif child.Parent.Name:match("Button") or child.Parent.Name == "GraySquare" then
				table.insert(tweens, TweenService:Create(child, TweenInfo.new(0.3), {Transparency = 1}))
			end
		end
		if child:IsA("ImageLabel") then
			table.insert(tweens, TweenService:Create(child, TweenInfo.new(0.3), {ImageTransparency = 0}))
		end
	end
	
	table.insert(tweens, TweenService:Create(Line, TweenInfo.new(0.3), {BackgroundTransparency = 0.8}))
	table.insert(tweens, TweenService:Create(AvatarStroke, TweenInfo.new(0.3), {Transparency = 0.5}))
	table.insert(tweens, TweenService:Create(ContainerStroke, TweenInfo.new(0.3), {Transparency = 0.8}))
	table.insert(tweens, TweenService:Create(ContentContainerStroke, TweenInfo.new(0.3), {Transparency = 0.8}))
	
	for _, tween in pairs(tweens) do tween:Play() end
end

