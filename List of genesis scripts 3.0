-- Reanimate GUI Script
-- Created with smooth animations and modern design
-- Silent execution - no notifications

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local player = Players.LocalPlayer
local mouse = player:GetMouse()

-- Function to play toggle sound
local function playToggleSound()
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://177266782"
	sound.Volume = 0.5
	sound.Parent = workspace
	sound:Play()
	game:GetService("Debris"):AddItem(sound, sound.TimeLength)
end

-- Function to copy to clipboard without notification
local function copyToClipboard(text)
	playToggleSound()
	pcall(function()
		setclipboard(text)
	end)
end

-- Main GUI Container
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "ReanimateGUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- Mobile detection and scaling
local isMobile = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
if isMobile then ScreenGui.DisplayOrder = 10 end

-- Main UI Frame
local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Size = isMobile and UDim2.new(0.85, 0, 0.7, 0) or UDim2.new(0, 500, 0, 500)
MainFrame.Position = isMobile and UDim2.new(0.5, 0, 0.5, 0) or UDim2.new(0.5, -250, 0.5, -250)
MainFrame.AnchorPoint = isMobile and Vector2.new(0.5, 0.5) or Vector2.new(0, 0)
MainFrame.BackgroundColor3 = Color3.new(0, 0, 0)
MainFrame.BackgroundTransparency = 0.3
MainFrame.BorderSizePixel = 0
MainFrame.ClipsDescendants = true

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 12)
UICorner.Parent = MainFrame

local UIStroke = Instance.new("UIStroke")
UIStroke.Color = Color3.new(1, 1, 1)
UIStroke.Transparency = 0.7
UIStroke.Thickness = 1
UIStroke.Parent = MainFrame

-- Drag functionality
local dragging, dragInput, dragStart, startPos
local function update(input)
	local delta = input.Position - dragStart
	local newX = startPos.X.Offset + delta.X
	local newY = startPos.Y.Offset + delta.Y
	TweenService:Create(MainFrame, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.new(startPos.X.Scale, newX, startPos.Y.Scale, newY)
	}):Play()
end

MainFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = MainFrame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)

MainFrame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input == dragInput) then update(input) end
end)

