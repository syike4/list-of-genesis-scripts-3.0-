-- Reanimate toggle
ReanimateToggle.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		FadeOutAll(function()
			SetToggleActive(ReanimateToggle, ReanimateLabel)
			HideAllSidebarLines()
			ShowLineForToggle(ReanimateToggle)
			ClearScroller()
			
			for i, scriptData in ipairs(reanimationScripts) do
				local toggle, label = CreateToggle(scriptData.name, Scroller)
				toggle.Position = UDim2.new(0, 10, 0, 10 + ((i-1) * 55))
				toggle.Size = UDim2.new(1, -20, 0, 45)
				
				toggle.InputBegan:Connect(function(clickInput)
					if clickInput.UserInputType == Enum.UserInputType.MouseButton1 then
						playToggleSound()
						
						local originalBg = toggle.BackgroundColor3
						local originalText = label.TextColor3
						
						TweenService:Create(toggle, TweenInfo.new(0.3), {BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0}):Play()
						TweenService:Create(label, TweenInfo.new(0.3), {TextColor3 = Color3.new(0, 0, 0)}):Play()
						
						ExecuteReanimation(scriptData)
						
						wait(0.3)
						
						TweenService:Create(toggle, TweenInfo.new(0.3), {BackgroundColor3 = originalBg, BackgroundTransparency = 0.2}):Play()
						TweenService:Create(label, TweenInfo.new(0.3), {TextColor3 = originalText}):Play()
					end
				end)
			end
			
			Scroller.CanvasSize = UDim2.new(0, 0, 0, #reanimationScripts * 55 + 20)
			FadeInAll()
		end)
	end
end)

