			OriginalCreditsLabel.BackgroundTransparency = 1
			OriginalCreditsLabel.TextYAlignment = Enum.TextYAlignment.Top
			OriginalCreditsLabel.Parent = Scroller
			
			Scroller.CanvasSize = UDim2.new(0, 0, 0, (#credits * 90) + 120)
			FadeInAll()
		end)
	end
end)

