-- Credits toggle
CreditsToggle.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		FadeOutAll(function()
			-- Set Credits as active toggle
			SetToggleActive(CreditsToggle, CreditsLabel)
			
			HideAllSidebarLines()
			ShowLineForToggle(CreditsToggle)
			ClearScroller()
			
			-- Add Credits content with the provided credits
			local credits = {
				{name = "GENESIS FE", decal = "83629928978659", youtube = "https://www.youtube.com/@GENESIS-FE"},
				{name = "White Hat", decal = "89278194521463", youtube = "https://www.youtube.com/@White_hat.1"},
				{name = "Melon Scripter", decal = "76587137674905", youtube = "https://www.youtube.com/@MelonScripter"},
				{name = "Im_Patrick", decal = "122828131564451", youtube = "https://www.youtube.com/@Im_Patrick"}
			}
			
			for i, credit in ipairs(credits) do
				CreateCreditButton(credit.name, credit.decal, credit.youtube, Scroller, 10 + ((i-1) * 90))
			end
			
			-- Add extra spacing and original credits
			local OriginalCreditsLabel = Instance.new("TextLabel")
			OriginalCreditsLabel.Name = "OriginalCreditsLabel"
			OriginalCreditsLabel.Size = UDim2.new(1, -20, 0, 100)
			OriginalCreditsLabel.Position = UDim2.new(0, 10, 0, 10 + (#credits * 90))
